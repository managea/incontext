{
  "name": "incontext",
  "displayName": "Code Reference Extension",
  "description": "Prompt the right way. Structure your AI prompts naturally, with inline, pinpoint-accurate code references — delivering better LLM outputs, preserving your visual context, and enabling logical, easy-to-read prompts.",
  "publisher": "managea",
  "version": "1.3.0",
  "icon": "icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/managea/incontext.git"
  },
  "bugs": {
    "url": "https://github.com/managea/incontext.git"
  },
  "homepage": "https://github.com/managea/incontext.git#readme",
  "author": {
    "name": "Asanga Manage",
    "email": "asanga.lk@gmail.com"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "extensionDependencies": [],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "markdown.markdownItPlugins": true,
    "configuration": {
      "title": "InContext",
      "properties": {
        "incontext.linkServer.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "markdownDescription": "Open references from `http://localhost:<port>/open#@project/src/file.ts:L10:20` links, such as the ones the Claude desktop app shows. The link server listens on 127.0.0.1 only and opens files inside your workspace folders only."
        },
        "incontext.linkServer.port": {
          "type": "integer",
          "default": 46266,
          "minimum": 1024,
          "maximum": 65535,
          "scope": "application",
          "markdownDescription": "Port of the link server (`#incontext.linkServer.enabled#`). All VS Code windows share it: the first window to start answers links and passes each one on to the window that has the reference's folder."
        }
      }
    },
    "markdown.previewStyles": [
      "./media/markdown-preview.css"
    ],
    "markdown.previewScripts": [
      "./media/markdown-preview.js"
    ],
    "commands": [
      {
        "command": "incontext.copyCodeReference",
        "title": "Copy Code Reference to Clipboard"
      },
      {
        "command": "incontext.copyFileReference",
        "title": "Copy File Reference to Clipboard"
      },
      {
        "command": "incontext.copyDirectoryReference",
        "title": "Copy Directory Reference to Clipboard"
      },
      {
        "command": "incontext.openReference",
        "title": "Open Reference"
      },
      {
        "command": "incontext.setUpAiInstructions",
        "title": "Set Up AI Assistant Instructions",
        "category": "InContext"
      },
      {
        "command": "incontext.removeAiInstructions",
        "title": "Remove AI Assistant Instructions",
        "category": "InContext"
      }
    ],
    "keybindings": [
      {
        "command": "incontext.copyCodeReference",
        "key": "cmd+'",
        "mac": "cmd+'",
        "when": "editorTextFocus && editorHasSelection"
      },
      {
        "command": "incontext.copyCodeReference",
        "key": "cmd+'",
        "mac": "cmd+'",
        "when": "editorTextFocus && !editorHasSelection"
      },
      {
        "command": "incontext.copyFileReference",
        "key": "cmd+'",
        "mac": "cmd+'",
        "when": "filesExplorerFocus && !explorerResourceIsFolder && resourceSet"
      },
      {
        "command": "incontext.copyDirectoryReference",
        "key": "cmd+'",
        "mac": "cmd+'",
        "when": "filesExplorerFocus && explorerResourceIsFolder && resourceSet"
      }
    ],
    "viewsContainers": {},
    "views": {},
    "menus": {
      "editor/context": [
        {
          "when": "editorHasSelection",
          "command": "incontext.copyCodeReference",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "incontext.copyFileReference",
          "when": "!explorerResourceIsFolder",
          "group": "navigation"
        },
        {
          "command": "incontext.copyDirectoryReference",
          "when": "explorerResourceIsFolder",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "package-extension": "vsce package",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit --project tsconfig.json",
    "lint": "eslint src",
    "sync-readme": "npm run compile-tests && node -e \"require('./out/AiInstructions.js').AiInstructions.syncReadme(process.cwd())\"",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.96.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "eslint": "^9.25.1",
    "esbuild": "^0.25.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.8.3",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^3.1.0"
  }
}
