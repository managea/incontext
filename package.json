{
  "name": "incontext",
  "displayName": "Code Reference Extension",
  "description": "Read, check and steer the code your AI agents write: pinpoint code references, notes on code, the callers of any function, and every change since main, a click from the lines they are about.",
  "publisher": "managea",
  "version": "2.1.1",
  "icon": "icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/managea/incontext.git"
  },
  "bugs": {
    "url": "https://github.com/managea/incontext.git"
  },
  "homepage": "https://github.com/managea/incontext.git#readme",
  "author": {
    "name": "Asanga Manage",
    "email": "asanga.lk@gmail.com"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "extensionDependencies": [],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "markdown.markdownItPlugins": true,
    "colors": [
      {
        "id": "incontext.callerTree.file1",
        "description": "Caller Tree: the blue given to the first file a tree meets (the root's file is the first).",
        "defaults": { "dark": "#3794FF", "light": "#1A85FF", "highContrast": "#3794FF", "highContrastLight": "#1A85FF" }
      },
      {
        "id": "incontext.callerTree.file2",
        "description": "Caller Tree: the orange given to the second file a tree meets (the root's file is the first).",
        "defaults": { "dark": "#D18616", "light": "#B26B00", "highContrast": "#D18616", "highContrastLight": "#B26B00" }
      },
      {
        "id": "incontext.callerTree.file3",
        "description": "Caller Tree: the purple given to the third file a tree meets (the root's file is the first).",
        "defaults": { "dark": "#B180D7", "light": "#8E4BC4", "highContrast": "#B180D7", "highContrastLight": "#8E4BC4" }
      },
      {
        "id": "incontext.callerTree.file4",
        "description": "Caller Tree: the green given to the fourth file a tree meets (the root's file is the first).",
        "defaults": { "dark": "#89D185", "light": "#388A34", "highContrast": "#89D185", "highContrastLight": "#388A34" }
      },
      {
        "id": "incontext.callerTree.file5",
        "description": "Caller Tree: the red given to the fifth file a tree meets (the root's file is the first).",
        "defaults": { "dark": "#F48771", "light": "#C72E0F", "highContrast": "#F48771", "highContrastLight": "#C72E0F" }
      },
      {
        "id": "incontext.callerTree.file6",
        "description": "Caller Tree: the yellow given to the sixth file a tree meets (the root's file is the first).",
        "defaults": { "dark": "#DCDCAA", "light": "#8C7400", "highContrast": "#DCDCAA", "highContrastLight": "#8C7400" }
      },
      {
        "id": "incontext.callerTree.file7",
        "description": "Caller Tree: the pink given to the seventh file a tree meets (the root's file is the first).",
        "defaults": { "dark": "#E07EC2", "light": "#B5368B", "highContrast": "#E07EC2", "highContrastLight": "#B5368B" }
      },
      {
        "id": "incontext.callerTree.file8",
        "description": "Caller Tree: the teal given to the eighth file a tree meets (the root's file is the first).",
        "defaults": { "dark": "#4EC9B0", "light": "#00808A", "highContrast": "#4EC9B0", "highContrastLight": "#00808A" }
      }
    ],
    "configuration": {
      "title": "InContext",
      "properties": {
        "incontext.linkServer.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "markdownDescription": "Open references from `http://localhost:<port>/open#@project/src/file.ts:L10:20` links, such as the ones the Claude desktop app shows. The link server listens on 127.0.0.1 only and opens files inside your workspace folders only."
        },
        "incontext.linkServer.port": {
          "type": "integer",
          "default": 46266,
          "minimum": 1024,
          "maximum": 65535,
          "scope": "application",
          "markdownDescription": "Port of the link server (`#incontext.linkServer.enabled#`). All VS Code windows share it: the first window to start answers links and passes each one on to the window that has the reference's folder."
        },
        "incontext.callerTree.colorByFile": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Colour each function's name and icon in the Caller Tree by its file, so rows in the same file share a colour. The colours are `incontext.callerTree.file1` to `file8`, which `#workbench.colorCustomizations#` can change."
        },
        "incontext.notes.position": {
          "type": "string",
          "enum": [
            "above",
            "below"
          ],
          "enumDescriptions": [
            "Above the note's lines",
            "Under the note's lines, where VS Code puts comments"
          ],
          "default": "above",
          "markdownDescription": "Where a note's box shows: above its lines or under them."
        },
        "incontext.notes.showBackLinkNotes": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Quote the note in each back-link (`← handler.ts:L30`). Off, a back-link shows only its link, and the note on hover."
        },
        "incontext.notes.startClosed": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Start each note's box closed: its line shows the InContext logo in the gutter and the note on hover, and a click on the logo opens it. A note you have just written stays open. Off, a box with a note starts open."
        },
        "incontext.notes.gutterAddButton": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Show a **+** beside each line, on hover, that adds a note there, as for a review comment. VS Code then also draws a grey bar down the gutter of every file, beside the lines that can take a note. Off, add a note with **InContext: Add Note** (`Cmd+Alt+N`) or the editor's context menu."
        },
        "incontext.notes.folder": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Folder for your notes on code (**InContext: Add Note**). In your user settings, keep it outside your repositories, so notes are never committed: each source file's notes are a Markdown file at `<folder>/<project>/<path in the project>.md`, and a synced folder shares them between machines. To keep a project's notes inside it and commit them, set a relative folder such as `.notes` in the project's own settings (`.vscode/settings.json`): its notes are then at `<project>/.notes/<path in the project>.md`. `~` is your home folder."
        },
        "incontext.compare.hideGitGutter": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "While a repository is compared with a branch (**InContext: Compare with Branch**), hide git's own gutter markers, which compare with your last commit, so the gutter shows only the changes since that branch."
        }
      }
    },
    "markdown.previewStyles": [
      "./media/markdown-preview.css"
    ],
    "markdown.previewScripts": [
      "./media/markdown-preview.js"
    ],
    "commands": [
      {
        "command": "incontext.copyCodeReference",
        "title": "Copy Code Reference to Clipboard"
      },
      {
        "command": "incontext.copyFileReference",
        "title": "Copy File Reference to Clipboard"
      },
      {
        "command": "incontext.copyDirectoryReference",
        "title": "Copy Directory Reference to Clipboard"
      },
      {
        "command": "incontext.copyReferenceAsLink",
        "title": "Copy Reference as Link (for Drawings)"
      },
      {
        "command": "incontext.addNote",
        "title": "Add Note",
        "category": "InContext"
      },
      {
        "command": "incontext.notes.create",
        "title": "Save Note"
      },
      {
        "command": "incontext.notes.cancelDraft",
        "title": "Cancel"
      },
      {
        "command": "incontext.notes.edit",
        "title": "Edit Note",
        "icon": "$(edit)"
      },
      {
        "command": "incontext.notes.save",
        "title": "Save"
      },
      {
        "command": "incontext.notes.cancelEdit",
        "title": "Cancel"
      },
      {
        "command": "incontext.notes.delete",
        "title": "Delete Note",
        "icon": "$(trash)"
      },
      {
        "command": "incontext.notes.openMarkdown",
        "title": "Open as Markdown",
        "icon": "$(go-to-file)"
      },
      {
        "command": "incontext.notes.cancelFocused",
        "title": "Cancel Note Edit"
      },
      {
        "command": "incontext.notes.refreshView",
        "title": "Refresh Notes",
        "icon": "$(refresh)"
      },
      {
        "command": "incontext.notes.submitFocused",
        "title": "Save Note Edit"
      },
      {
        "command": "incontext.openReference",
        "title": "Open Reference"
      },
      {
        "command": "incontext.setUpAiInstructions",
        "title": "Set Up AI Assistant Instructions",
        "category": "InContext"
      },
      {
        "command": "incontext.removeAiInstructions",
        "title": "Remove AI Assistant Instructions",
        "category": "InContext"
      },
      {
        "command": "incontext.installObsidianPlugin",
        "title": "Install Obsidian Plugin",
        "category": "InContext"
      },
      {
        "command": "incontext.removeObsidianPlugin",
        "title": "Remove Obsidian Plugin",
        "category": "InContext"
      },
      {
        "command": "incontext.callerTree.pin",
        "title": "InContext: Pin Caller Tree",
        "icon": "$(pin)"
      },
      {
        "command": "incontext.callerTree.unpin",
        "title": "InContext: Unpin Caller Tree",
        "icon": "$(pinned)"
      },
      {
        "command": "incontext.callerTree.refresh",
        "title": "InContext: Refresh Caller Tree",
        "icon": "$(refresh)"
      },
      {
        "command": "incontext.callerTree.expand",
        "title": "InContext: Expand Caller Tree",
        "icon": "$(expand-all)"
      },
      {
        "command": "incontext.callerTree.collapse",
        "title": "InContext: Collapse Caller Tree",
        "icon": "$(collapse-all)"
      },
      {
        "command": "incontext.callerTree.foldSameFile",
        "title": "InContext: Fold Calls Within a File",
        "icon": "$(filter)"
      },
      {
        "command": "incontext.callerTree.unfoldSameFile",
        "title": "InContext: Show Calls Within a File",
        "icon": "$(filter-filled)"
      },
      {
        "command": "incontext.callerTree.openToSide",
        "title": "Open to the Side"
      },
      {
        "command": "incontext.compare.chooseBase",
        "title": "Compare with Branch…",
        "category": "InContext",
        "icon": "$(git-compare)"
      },
      {
        "command": "incontext.compare.stop",
        "title": "Stop Comparing with Branch",
        "category": "InContext",
        "icon": "$(close)"
      },
      {
        "command": "incontext.compare.useTip",
        "title": "Compare with the Branch's Tip",
        "category": "InContext",
        "icon": "$(git-merge)"
      },
      {
        "command": "incontext.compare.useMergeBase",
        "title": "Compare from the Merge-Base",
        "category": "InContext",
        "icon": "$(git-commit)"
      },
      {
        "command": "incontext.compare.toggleMode",
        "title": "Switch Between Merge-Base and Tip",
        "category": "InContext"
      },
      {
        "command": "incontext.compare.followEditor",
        "title": "Follow the Editor",
        "category": "InContext",
        "icon": "$(eye-closed)"
      },
      {
        "command": "incontext.compare.stopFollowingEditor",
        "title": "Stop Following the Editor",
        "category": "InContext",
        "icon": "$(eye)"
      },
      {
        "command": "incontext.compare.refresh",
        "title": "Refresh Changes",
        "category": "InContext",
        "icon": "$(refresh)"
      },
      {
        "command": "incontext.compare.openDiff",
        "title": "Open Changes",
        "category": "InContext",
        "icon": "$(diff)"
      }
    ],
    "keybindings": [
      {
        "command": "incontext.copyCodeReference",
        "key": "cmd+'",
        "mac": "cmd+'",
        "when": "editorTextFocus && editorHasSelection"
      },
      {
        "command": "incontext.copyCodeReference",
        "key": "cmd+'",
        "mac": "cmd+'",
        "when": "editorTextFocus && !editorHasSelection"
      },
      {
        "command": "incontext.copyFileReference",
        "key": "cmd+'",
        "mac": "cmd+'",
        "when": "filesExplorerFocus && !explorerResourceIsFolder && resourceSet"
      },
      {
        "command": "incontext.copyDirectoryReference",
        "key": "cmd+'",
        "mac": "cmd+'",
        "when": "filesExplorerFocus && explorerResourceIsFolder && resourceSet"
      },
      {
        "command": "incontext.copyReferenceAsLink",
        "key": "ctrl+alt+'",
        "mac": "cmd+alt+'",
        "when": "editorTextFocus"
      },
      {
        "command": "incontext.addNote",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n",
        "when": "editorTextFocus && !commentEditorFocused"
      },
      {
        "command": "incontext.notes.cancelFocused",
        "key": "escape",
        "when": "commentEditorFocused && commentController == incontext.notes"
      },
      {
        "command": "incontext.notes.submitFocused",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "commentEditorFocused && commentController == incontext.notes"
      },
      {
        "command": "incontext.callerTree.openToSide",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "focusedView == incontext.callerTree"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "incontext",
          "title": "InContext",
          "icon": "media/incontext-activity.svg"
        }
      ]
    },
    "views": {
      "incontext": [
        {
          "id": "incontext.notes",
          "name": "Notes",
          "icon": "media/incontext-activity.svg"
        },
        {
          "id": "incontext.callerTree",
          "name": "Caller Tree"
        },
        {
          "id": "incontext.changes",
          "name": "Branch Changes",
          "icon": "$(git-compare)"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "incontext.notes",
        "contents": "No notes yet. Put the cursor on a line, or select lines, and run [InContext: Add Note](command:incontext.addNote). Notes and the places they point to show here as chains."
      },
      {
        "view": "incontext.callerTree",
        "contents": "Put the cursor on a function to see what calls it, and what reaches those, up to its entry points: route handlers, module code and functions nothing else uses. Needs a language server for the file's language (TypeScript and JavaScript out of the box).",
        "when": "!incontext.callerTree.started"
      },
      {
        "view": "incontext.changes",
        "contents": "See what your branch changes compared with another one, such as main, in the gutter of every editor and as a tree here: the files a merge request would show, uncommitted edits included.\n[Compare with Branch…](command:incontext.compare.chooseBase)",
        "when": "!incontext.compare.active"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "incontext.notes.create",
          "when": "false"
        },
        {
          "command": "incontext.notes.cancelDraft",
          "when": "false"
        },
        {
          "command": "incontext.notes.edit",
          "when": "false"
        },
        {
          "command": "incontext.notes.save",
          "when": "false"
        },
        {
          "command": "incontext.notes.cancelEdit",
          "when": "false"
        },
        {
          "command": "incontext.notes.delete",
          "when": "false"
        },
        {
          "command": "incontext.notes.openMarkdown",
          "when": "false"
        },
        {
          "command": "incontext.notes.cancelFocused",
          "when": "false"
        },
        {
          "command": "incontext.notes.submitFocused",
          "when": "false"
        },
        {
          "command": "incontext.notes.refreshView",
          "when": "false"
        },
        {
          "command": "incontext.callerTree.openToSide",
          "when": "false"
        },
        {
          "command": "incontext.compare.openDiff",
          "when": "false"
        },
        {
          "command": "incontext.compare.useTip",
          "when": "incontext.compare.active && !incontext.compare.tip"
        },
        {
          "command": "incontext.compare.useMergeBase",
          "when": "incontext.compare.active && incontext.compare.tip"
        },
        {
          "command": "incontext.compare.stop",
          "when": "incontext.compare.active"
        },
        {
          "command": "incontext.compare.followEditor",
          "when": "!incontext.compare.followEditor"
        },
        {
          "command": "incontext.compare.stopFollowingEditor",
          "when": "incontext.compare.followEditor"
        }
      ],
      "view/title": [
        {
          "command": "incontext.notes.refreshView",
          "group": "navigation",
          "when": "view == incontext.notes"
        },
        {
          "command": "incontext.callerTree.pin",
          "when": "view == incontext.callerTree && !incontext.callerTree.pinned",
          "group": "navigation"
        },
        {
          "command": "incontext.callerTree.unpin",
          "when": "view == incontext.callerTree && incontext.callerTree.pinned",
          "group": "navigation"
        },
        {
          "command": "incontext.callerTree.expand",
          "when": "view == incontext.callerTree && !incontext.callerTree.expanded",
          "group": "navigation"
        },
        {
          "command": "incontext.callerTree.collapse",
          "when": "view == incontext.callerTree && incontext.callerTree.expanded",
          "group": "navigation"
        },
        {
          "command": "incontext.callerTree.foldSameFile",
          "when": "view == incontext.callerTree && !incontext.callerTree.folded",
          "group": "navigation"
        },
        {
          "command": "incontext.callerTree.unfoldSameFile",
          "when": "view == incontext.callerTree && incontext.callerTree.folded",
          "group": "navigation"
        },
        {
          "command": "incontext.callerTree.refresh",
          "when": "view == incontext.callerTree",
          "group": "navigation"
        },
        {
          "command": "incontext.compare.chooseBase",
          "when": "view == incontext.changes",
          "group": "navigation@1"
        },
        {
          "command": "incontext.compare.useTip",
          "when": "view == incontext.changes && incontext.compare.active && !incontext.compare.tip",
          "group": "navigation@2"
        },
        {
          "command": "incontext.compare.useMergeBase",
          "when": "view == incontext.changes && incontext.compare.active && incontext.compare.tip",
          "group": "navigation@2"
        },
        {
          "command": "incontext.compare.followEditor",
          "when": "view == incontext.changes && incontext.compare.active && !incontext.compare.followEditor",
          "group": "navigation@3"
        },
        {
          "command": "incontext.compare.stopFollowingEditor",
          "when": "view == incontext.changes && incontext.compare.active && incontext.compare.followEditor",
          "group": "navigation@3"
        },
        {
          "command": "incontext.compare.refresh",
          "when": "view == incontext.changes && incontext.compare.active",
          "group": "navigation@4"
        },
        {
          "command": "incontext.compare.stop",
          "when": "view == incontext.changes && incontext.compare.active",
          "group": "navigation@5"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "incontext.notes.create",
          "group": "inline@1",
          "when": "commentController == incontext.notes && commentThreadIsEmpty"
        },
        {
          "command": "incontext.notes.cancelDraft",
          "group": "inline@2",
          "when": "commentController == incontext.notes && commentThreadIsEmpty"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "incontext.notes.edit",
          "group": "inline",
          "when": "commentController == incontext.notes && commentThread =~ /^incontext\\.(note|backlinks)$/"
        },
        {
          "command": "incontext.notes.openMarkdown",
          "group": "inline",
          "when": "commentController == incontext.notes && commentThread == incontext.note"
        },
        {
          "command": "incontext.notes.delete",
          "group": "inline",
          "when": "commentController == incontext.notes && commentThread == incontext.note"
        }
      ],
      "comments/comment/context": [
        {
          "command": "incontext.notes.save",
          "group": "inline@1",
          "when": "commentController == incontext.notes && comment == incontext.note"
        },
        {
          "command": "incontext.notes.cancelEdit",
          "group": "inline@2",
          "when": "commentController == incontext.notes && comment == incontext.note"
        }
      ],
      "editor/context": [
        {
          "when": "editorHasSelection",
          "command": "incontext.copyCodeReference",
          "group": "navigation"
        },
        {
          "command": "incontext.copyReferenceAsLink",
          "group": "navigation"
        },
        {
          "command": "incontext.addNote",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "incontext.copyFileReference",
          "when": "!explorerResourceIsFolder",
          "group": "navigation"
        },
        {
          "command": "incontext.copyDirectoryReference",
          "when": "explorerResourceIsFolder",
          "group": "navigation"
        },
        {
          "command": "incontext.copyReferenceAsLink",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "incontext.callerTree.openToSide",
          "when": "view == incontext.callerTree && viewItem == place",
          "group": "navigation"
        },
        {
          "command": "incontext.compare.openDiff",
          "when": "view == incontext.changes && viewItem =~ /^(file|deletedFile)$/",
          "group": "inline"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js && npm run build:obsidian",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production && npm run build:obsidian",
    "package-extension": "vsce package",
    "build:obsidian": "tsc --noEmit -p obsidian && eslint obsidian && node obsidian/esbuild.js",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit --project tsconfig.json",
    "lint": "eslint src",
    "sync-readme": "npm run compile-tests && node -e \"require('./out/AiInstructions.js').AiInstructions.syncReadme(process.cwd())\"",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.96.0",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.25.3",
    "eslint": "^9.25.1",
    "npm-run-all": "^4.1.5",
    "obsidian": "^1.14.4",
    "typescript": "^5.8.3"
  }
}
